CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# FATFS: allow long filenames, bigger sector cache for sequential reads
CONFIG_FATFS_LFN_HEAP=y
# FATFS: seek inside the 245 MB model file without walking the FAT chain
CONFIG_FATFS_USE_FASTSEEK=y
# FATFS buffers are max(SD sector, wear-levelling sector) bytes per open file.
# Wear levelling (FAT on internal flash) is unused: 512 makes them 512 bytes
# instead of 4 KB, and the RAM goes to a bigger prompt batch.
CONFIG_FATFS_SECTOR_512=y
CONFIG_WL_SECTOR_SIZE_512=y
# Wi-Fi weight streaming experiment (wifi_test.cpp, kWifiTest in main.cpp;
# docs/experiments.md #29). Only linked into the test build. Smallest
# config that still helped: 48 KB connected, ~73 KB at peak, 1.6 MB/s next to
# the SD card's 8.7. lwIP on core 0: on core 1 it slows the SD reader.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
